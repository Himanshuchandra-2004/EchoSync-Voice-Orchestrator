# ---- Required ----
GROQ_API_KEY=your_groq_api_key_here

# ---- TTS Engine (lokutor | edge) ----
TTS_ENGINE=lokutor
LOKUTOR_API_KEY=your_lokutor_api_key_here

# ---- Optional Lokutor tuning ----
# LOKUTOR_VOICE=M1          # M1-M5, F1-F5 (see docs.lokutor.com/voices-languages-models)
# LOKUTOR_LANGUAGE=en        # en, es, ca, gl, eu, pt, fr, it, de
# LOKUTOR_SPEED=1.05         # 0.5–2.0
# LOKUTOR_STEPS=8            # lower = faster (8=ultra-fast, 32=high quality)

# ---- Edge TTS fallback (no key needed) ----
# TTS_ENGINE=edge

# ---- ElevenLabs (alternative, not used by default) ----
# ELEVENLABS_API_KEY=your_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
